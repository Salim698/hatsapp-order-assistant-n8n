    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "={{ $env.GEMINI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ role: 'user', parts: [{ text: 'Analyse ce message client et retourne UNIQUEMENT un JSON valide.\\n\\nMessage: ' + $json.message + '\\n\\nFormat:\\n{\"intent\": \"order | question | support\", \"product\": \"\", \"quantity\": 1, \"confidence\": 0.0}\\n\\nintent = order si le client veut acheter, question si le client demande un produit, un prix ou la disponibilité, support pour tout le reste.' }] }], generationConfig: { responseMimeType: 'application/json' } }) }}",
        "options": {}
      },
      "id": "6b6cc606-dcd6-4917-8360-7817fdcda695",
