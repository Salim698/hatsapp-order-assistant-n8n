        "mode": "runOnceForEachItem",
        "jsCode": "const message = $json.body?.message || '';\nconst phone = $json.body?.phone || '';\nconst name = $json.body?.name || 'Client';\n\nreturn {\n  json: {\n    message: message,\n    original_phone: phone,\n    original_name: name\n  }\n};"
      },
