    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ctx = $('Extract Message').item.json;\nconst allowed = ['order', 'question', 'support'];\n\ntry {\n  const rawContent = $json.candidates?.[0]?.content?.parts?.[0]?.text || '';\n\n  const cleanString = rawContent\n    .replace(/```json/g, '')\n    .replace(/```/g, '')\n    .trim();\n\n  const parsed = JSON.parse(cleanString);\n\n  return {\n    json: {\n      message: ctx.message,\n      original_phone: ctx.original_phone,\n      original_name: ctx.original_name,\n      intent: allowed.includes(parsed.intent) ? parsed.intent : 'support',\n      product: parsed.product || '',\n      quantity: Number(parsed.quantity) || 1,\n      confidence: Number(parsed.confidence) || 0\n    }\n  };\n} catch (error) {\n  return {\n    json: {\n      message: ctx.message,\n      original_phone: ctx.original_phone,\n      original_name: ctx.original_name,\n      intent: 'support',\n      product: '',\n      quantity: 1,\n      confidence: 0,\n      error: error.message\n    }\n  };\n}"
      },
